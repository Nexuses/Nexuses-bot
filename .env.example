MONGODB_URI=mongodb://127.0.0.1:27017/nexuses-bot
# Or Atlas, for example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexuses-bot
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL for share links (no trailing slash).
# Local: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# Notion public OAuth integration (https://www.notion.so/my-integrations)
# Register BOTH redirect URIs in Notion (OAuth uses the current host, not a hardcode):
#   http://localhost:3000/api/oauth/notion/callback
#   https://bot.nexuses-online.com/api/oauth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Chat model. DeepSeek is used when set; otherwise OpenAI.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini
