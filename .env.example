MONGODB_URI=mongodb://127.0.0.1:27017/nexuses-bot
# Or Atlas, for example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/nexuses-bot
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL for share links (no trailing slash).
# Local: http://localhost:3000
# Production: https://your-domain.com
# Public base URL for share links + OAuth redirects (no trailing slash).
# Local: http://localhost:3000
# Production: https://bot.nexuses-online.com
# Notion OAuth uses this value — wrong APP_URL causes "invalid redirect_uri".
APP_URL=http://localhost:3000

# Notion public OAuth integration (https://www.notion.so/my-integrations)
# Register BOTH redirect URIs in Notion:
#   http://localhost:3000/api/oauth/notion/callback
#   https://bot.nexuses-online.com/api/oauth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Chat model — Grok (xAI) is the default when XAI_API_KEY or GROK_API_KEY is set.
# Create a key: https://console.x.ai
LLM_PROVIDER=grok
XAI_API_KEY=
# Alias (same as XAI_API_KEY):
# GROK_API_KEY=
# Optional model (default grok-4.6 — tools + vision on one model):
# GROK_MODEL=grok-4.6
# Optional token caps (lower = snappier replies):
# LLM_MAX_TOKENS_REPLY=2048
# LLM_MAX_TOKENS_TOOLS=8192
# XAI_API_BASE=https://api.x.ai/v1
# DEEPSEEK_API_KEY=
# LLM_PROVIDER=deepseek
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini

# Mem0 long-term chat memory (https://app.mem0.ai / https://github.com/mem0ai/mem0)
# When set, Nexuses remembers useful facts across chats for each user.
MEM0_API_KEY=
# Optional custom host for self-hosted Mem0 (default: https://api.mem0.ai)
# MEM0_HOST=
